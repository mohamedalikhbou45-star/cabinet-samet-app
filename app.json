{
  "expo": {
    "name": "Cabinet Samet",
    "slug": "cabinet-samet-app",
    "scheme": "cabinetsamet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0B2545",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.cabinetsamet.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Cabinet Samet a besoin de la caméra pour photographier vos documents.",
        "NSPhotoLibraryUsageDescription": "Cabinet Samet a besoin d'accéder à vos photos pour joindre un document existant."
      }
    },
    "android": {
      "package": "fr.cabinetsamet.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B2545",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES", "NOTIFICATIONS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Cabinet Samet a besoin de la caméra pour photographier vos documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cabinet Samet a besoin d'accéder à vos photos pour joindre un document existant."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#86BC25"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:3000"
    }
  }
}
